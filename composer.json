{
  "name": "siberfx/bunny-cdn",
  "description": "Bunny net CDN API class for handling pull zones, storage zones, video streaming and DNS.",
  "type": "library",
  "license": "MIT",
  "keywords": ["bunny", "bunnycdn", "bunny.net", "cdn", "storage", "stream", "dns", "laravel"],
  "minimum-stability": "stable",
  "authors": [
    {
      "name": "Selim Görmüş",
      "email": "info@siberfx.com",
      "role": "Software Engineer"
    }
  ],
  "require": {
    "php": "^8.4",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "suggest": {
    "ext-ftp": "Required for the FTP based storage methods (uploadFile, downloadFile, createFolder, ...)",
    "illuminate/support": "Required to use the Laravel service provider (^11.0|^12.0|^13.0)"
  },
  "autoload": {
    "psr-4": {
      "Siberfx\\BunnyCdn\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Siberfx\\BunnyCdn\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Siberfx\\BunnyCdn\\BunnyCdnServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
